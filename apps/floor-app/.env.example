# PalletIQ Floor App — environment variable template
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.
#
# Database connection (DATABASE_URL) is not a floor-app concern — see api/.env instead.

# Azure Functions local base URL (for Vite dev proxy if needed)
VITE_API_BASE_URL=http://localhost:7071
