{
  "name": "palletiq-api",
  "version": "1.4.0",
  "description": "PalletIQ — backend API (Express + Prisma/MySQL)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "rm -rf dist && prisma generate && tsc -p tsconfig.json",
    "postbuild": "cp -r generated dist/api/generated && printf \"import './api/index.js';\\n\" > dist/index.js",
    "watch": "tsc -p tsconfig.json --watch",
    "start": "tsx watch index.ts",
    "start:test": "node --env-file=.env.test node_modules/tsx/dist/cli.mjs index.ts",
    "lint": "eslint .",
    "test": "tsx --import ./tests/unit/setup.ts --test 'tests/unit/**/*.test.ts'",
    "test:db": "node --env-file=.env.test node_modules/tsx/dist/cli.mjs --test --test-concurrency=1 'tests/db/**/*.test.ts'",
    "test:api": "node --env-file=.env.test node_modules/tsx/dist/cli.mjs --test --test-concurrency=1 'tests/api/**/*.test.ts'",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "test:db:up": "node scripts/test-db.mjs up",
    "test:db:reset": "node scripts/test-db.mjs reset",
    "test:db:down": "node scripts/test-db.mjs down"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "8.3.0",
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "exceljs": "^4.4.0",
    "globals": "^17.8.0",
    "mariadb": "^3.5.3",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0"
  }
}
