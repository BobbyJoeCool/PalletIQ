{
  "name": "palletiq-api",
  "version": "1.0.0",
  "description": "PalletIQ — Azure Functions API",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "postbuild": "rm -rf dist/generated && cp -r generated dist/generated",
    "watch": "tsc -p tsconfig.json --watch",
    "start": "func start",
    "lint": "eslint ."
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@azure/functions": "^4.7.0",
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "exceljs": "^4.4.0",
    "globals": "^17.8.0",
    "mariadb": "^3.5.3",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0"
  }
}
