# Test-only environment for the isolated E2E database (issue #236). Committed on purpose:
# nothing here is a real secret. Points at the Docker MySQL in ../docker-compose.test.yml
# (port 3307), never the dev database on 3306.
#
# Loaded with `node --env-file=.env.test` (see package.json's test:db:* and start:test).
# index.ts and prisma.config.ts also call `dotenv/config`, but dotenv never overrides a
# variable that is already set, so these values win over api/.env.

DATABASE_URL="mysql://root:palletiq_test@127.0.0.1:3307/palletiq_test"
JWT_SECRET="palletiq-e2e-test-secret-not-for-real-use"
PORT=7072
